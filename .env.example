NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trelloclone
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=trello-clone-uploads
SPACES_KEY=
SPACES_SECRET=
SPACES_PUBLIC_BASE_URL=https://trello-clone-uploads.nyc3.cdn.digitaloceanspaces.com
UPLOAD_MAX_BYTES=26214400
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# SubZero incident reporting. The API files a ticket in the TRELLO project
# whenever a request fails with a 500. Ask for the ingest key.
SUBZERO_URL=https://api.sub-zero.dev/incidents/external
SUBZERO_PROJECT_KEY=TRELLO
SUBZERO_INGEST_KEY=
